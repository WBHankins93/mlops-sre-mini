{
  "uid": "irisapi",
  "title": "Iris API",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "tags": [
    "mlops",
    "sre",
    "demo"
  ],
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Predict Throughput (5m)",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(requests_total{endpoint=\"/predict\"}[5m]))",
          "legendFormat": "reqs/5m",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "501"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prediction Errors (5m)",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(predict_errors_total[5m]))",
          "legendFormat": "errors/5m",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "501"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 Latency (seconds)",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket{endpoint=\"/predict\"}[5m])) by (le))",
          "legendFormat": "p95 /predict",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "501"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      }
    }
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  }
}
